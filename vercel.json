{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=3600, stale-while-revalidate=604800" },
      "dest": "/static/landing/assets/$1"
    },
    {
      "src": "/images/(.*)",
      "headers": { "cache-control": "public, max-age=604800, stale-while-revalidate=2592000" },
      "dest": "/static/landing/images/$1"
    },
    {
      "src": "/static/(.*)",
      "headers": { "cache-control": "public, max-age=604800, stale-while-revalidate=2592000" },
      "dest": "/static/$1"
    },
    { "src": "/api/(.*)", "dest": "app.py" },
    { "src": "/map", "dest": "app.py" },
    { "src": "/", "dest": "app.py" },
    { "src": "/(.*)", "dest": "app.py" }
  ]
}
